{
  "realm": "discount",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "CUSTOMER",
        "description": "Can apply discount codes to a cart"
      }
    ]
  },
  "clients": [
    {
      "clientId": "discount-cli",
      "name": "Local demo client (password grant, development only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "email": "customer@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Customer",
      "credentials": [
        {
          "type": "password",
          "value": "customer",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "viewer",
          "temporary": false
        }
      ],
      "realmRoles": []
    }
  ]
}
